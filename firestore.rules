rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isHousehold(id) {
      return isSignedIn() && request.auth.uid == id;
    }

    // 동/호수 화이트리스트 + 로그인 정보. 실제 등록/비밀번호 검증은
    // Cloud Functions(householdLogin, Admin SDK)에서만 처리되므로
    // 클라이언트 쓰기는 관리자에게만 허용합니다.
    match /households/{id} {
      allow read: if isAdmin() || isHousehold(id);
      allow write: if isAdmin();
    }

    // 행사 배너. 로그인한 입주민/관리자 누구나 조회 가능, 수정은 관리자만.
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 신청 내역. 본인 세대 신청만 조회 가능(마스킹된 전체 현황은
    // getApplicationStatus 콜러블 함수를 통해서만 제공). 실제 생성/취소/수정은
    // applyToEvent / cancelApplication / updateApplication 함수(Admin SDK)에서만 처리합니다.
    match /applications/{applicationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.householdId == request.auth.uid);
      allow write: if isAdmin();
    }

    // 관리자 계정 메타정보. 커스텀 클레임 부여는 scripts/setAdminClaim.js로만 수행합니다.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
